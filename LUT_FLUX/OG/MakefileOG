# =============================================================================
# LUT_FLUX Makefile
# =============================================================================
#
# Builds:
#
#   generate_flux_lut
#
# Sources:
#
#   main.cpp
#   LRI.h
#   EarthDepth.h
#
# Dependencies obtained from pkg-config:
#
#   nuSQuIDS
#   SQuIDS
#   HDF5
#   GSL
#
# OpenMP is used for the (gprime, coszen) propagation grid.
# =============================================================================


CXX := g++

TARGET := generate_flux_lut
SRC := main.cpp

HEADERS := \
	LRI.h \
	EarthDepth.h


# -----------------------------------------------------------------------------
# nuSQuIDS configuration
# -----------------------------------------------------------------------------

NUSQ_CFLAGS := $(shell pkg-config --cflags nusquids)
NUSQ_LIBS   := $(shell pkg-config --libs nusquids)


# -----------------------------------------------------------------------------
# Compiler flags
# -----------------------------------------------------------------------------

CPPFLAGS := $(NUSQ_CFLAGS)

CXXFLAGS := \
	-O3 \
	-std=c++17 \
	-fopenmp \
	-Wall \
	-Wextra \
	-Wpedantic


# -----------------------------------------------------------------------------
# Linker flags
# -----------------------------------------------------------------------------

LDFLAGS := \
	-fopenmp

LDLIBS := \
	$(NUSQ_LIBS) \
	-lhdf5_hl

# -----------------------------------------------------------------------------
# Build
# -----------------------------------------------------------------------------

.PHONY: all clean info

all: $(TARGET)


$(TARGET): $(SRC) $(HEADERS)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) $(SRC) \
		$(LDFLAGS) $(LDLIBS) \
		-o $(TARGET)


# -----------------------------------------------------------------------------
# Show detected configuration
# -----------------------------------------------------------------------------

info:
	@echo "============================================================"
	@echo " LUT_FLUX build configuration"
	@echo "============================================================"
	@echo "Compiler:"
	@echo "  $(CXX)"
	@echo
	@echo "nuSQuIDS version:"
	@pkg-config --modversion nusquids
	@echo
	@echo "nuSQuIDS CFLAGS:"
	@echo "  $(NUSQ_CFLAGS)"
	@echo
	@echo "nuSQuIDS LIBS:"
	@echo "  $(NUSQ_LIBS)"
	@echo
	@echo "CXXFLAGS:"
	@echo "  $(CXXFLAGS)"
	@echo
	@echo "Target:"
	@echo "  $(TARGET)"
	@echo "============================================================"


# -----------------------------------------------------------------------------
# Clean
# -----------------------------------------------------------------------------

clean:
	rm -f $(TARGET)
